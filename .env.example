# ---------------------------------------------------------------------------
# Integration QA Automation – environment variables
#
# Copy this file to `.env` (git-ignored) and fill in the values.
# NEVER commit real credentials.
#
# Only two environments exist: local and uat. There is no production config.
# Shell / CI variables always win over .env; `.env.local` / `.env.uat` are also
# loaded (before `.env`) if you prefer one file per environment.
#
# Prefer the launcher UI (`npm run launcher`) for everything: testers (brand ID,
# API key, dashboard login), URLs, purchase data, test cards, logging.
# This file is a fallback – mainly for CI or command-line runs. Precedence:
# shell/CI → launcher settings.local.json → .env → config/defaults.json.
# ---------------------------------------------------------------------------

# Target environment: uat | local   (defaults to uat when empty)
TEST_ENV=uat

# Tester profile id from profiles.local.json (optional) and card scheme
TEST_PROFILE=
PAYMENT_METHOD=VISA

# ----- UAT (test4) ----------------------------------------------------------
UAT_BASE_URL=https://test4.paymentsclub.net
UAT_API_BASE_URL=https://test4.paymentsclub.net/api
UAT_BRAND_ID=
UAT_API_KEY=
# Back-office dashboard login (transactions / PSP logs) – fallback when no profile
UAT_DASHBOARD_USERNAME=
UAT_DASHBOARD_PASSWORD=

# Cashier test cards (<number>|<MM/YY>|<cvv>) – depend on the PSP the brand routes to.
# Only scenarios with a card run; CASHIER_CARDS=approved,declined limits the run.
UAT_CARD_APPROVED=
UAT_CARD_DECLINED=
CASHIER_CARDS=

# ----- LOCAL (defaults to test4 as well – see config/defaults.json) ---------
LOCAL_BASE_URL=
LOCAL_API_BASE_URL=
LOCAL_BRAND_ID=
LOCAL_API_KEY=
LOCAL_DASHBOARD_USERNAME=
LOCAL_DASHBOARD_PASSWORD=

# ----- Authentication behaviour ---------------------------------------------
# Purchase API expects:  Authorization: Bearer <API key>
API_KEY_HEADER=Authorization
API_KEY_PREFIX=Bearer
# OAuth2 client-credentials token path (leave empty – API-key auth is used)
AUTH_TOKEN_PATH=
CLIENT_ID=
CLIENT_SECRET=

# ----- Logging --------------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info
# Include (masked) request/response bodies in logs and report attachments
LOG_HTTP_BODIES=true

# ----- Reporting ------------------------------------------------------------
# Playwright trace mode: on | off | retain-on-failure | on-first-retry | on-all-retries
# Default: retain-on-failure locally, off in CI. Traces contain UNMASKED
# request data – never share them outside the team.
PW_TRACE=

# ----- Launcher UI ----------------------------------------------------------
LAUNCHER_PORT=4173

# ----- AI test-case generation (launcher → Test cases → Generate with AI) -----
# Paysecure AI gateway (WebSocket /v1/agent). Only the launcher reads these; test runs never get
# them. Do not commit the token. No Anthropic / Claude API key is used by this project.
# The link defaults to config/ai-gateway.json (committed). Only the token is needed:
# launcher → Test cases → "Add AI token…" writes it here for you.
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=
# Optional – pack (default: skill pack paysecure-qa deployed on the gateway, falls back to inline when
# it is missing) | inline (chat session with ai-skills/paysecure-qa/generate-test-cases/SKILL.md)
AI_GATEWAY_SKILLS=
# Optional – skill pack name (default paysecure-qa), model alias (default: gateway default)
AI_GATEWAY_SKILL_PACK=
AI_GATEWAY_MODEL=
# Optional – close an unused AI conversation after N seconds (default 300, frees the gateway seat)
AI_SESSION_IDLE_S=

# ----- KYC verification (tests/flows/kyc, launcher → KYC verification) ------
# KYC runs as the tester profile's merchant. That merchant needs a KYC provider MID
# (Dashboard → Merchant → KYC configuration), otherwise every create is 403 kyc_not_enabled.
# Or use another merchant that has one (per environment: LOCAL_ / UAT_):
LOCAL_KYC_API_KEY=
LOCAL_KYC_BRAND_ID=
# Dashboard merchant ID of that merchant – the webhook secret and provider are read from its KYC configuration.
LOCAL_KYC_MERCHANT_ID=
# …or give them directly (index 2 of the provider MID's ##-separated mid_auth_key). Unlocks the signed webhook cases.
LOCAL_KYC_WEBHOOK_SECRET=
KYC_PROVIDER=
# Country sent on every KYC create (default US)
KYC_COUNTRY=
# Optional second merchant – unlocks the cross-merchant isolation case (KYC-15)
LOCAL_KYC_API_KEY_2=
LOCAL_KYC_BRAND_ID_2=
# Optional public sink the SERVER can reach – for callback delivery cases
KYC_CALLBACK_URL=

# Bank & MID configuration cases (@BM-…): currency used as "convert to" / "only allowed"
# currency (default USD, EUR for USD purchases).
# BANK_CONFIG_CONVERT_TO=GBP

# S2S purchase: customer IP sent as remote_ip (must differ from the IP calling the API) and
# the APM used to check that S2S is refused for non-card methods.
# S2S_REMOTE_IP=157.38.242.7
# S2S_APM_METHOD=BANKTRANSFER
