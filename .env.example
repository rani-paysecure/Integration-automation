# ---------------------------------------------------------------------------
# Integration QA Automation – environment variables
#
# Copy this file to `.env` (git-ignored) and fill in the values.
# NEVER commit real credentials.
#
# Only two environments exist: local and uat. There is no production config.
# Shell / CI variables always win over .env; `.env.local` / `.env.uat` are also
# loaded (before `.env`) if you prefer one file per environment.
#
# Prefer the launcher UI (`npm run launcher`) for everything: testers (brand ID,
# API key, dashboard login), URLs, purchase data, test cards, logging.
# This file is a fallback – mainly for CI or command-line runs. Precedence:
# shell/CI → launcher settings.local.json → .env → config/defaults.json.
# ---------------------------------------------------------------------------

# Target environment: uat | local   (defaults to uat when empty)
TEST_ENV=uat

# Tester profile id from profiles.local.json (optional) and card scheme
TEST_PROFILE=
PAYMENT_METHOD=VISA

# ----- UAT (test4) ----------------------------------------------------------
UAT_BASE_URL=https://test4.paymentsclub.net
UAT_API_BASE_URL=https://test4.paymentsclub.net/api
UAT_BRAND_ID=
UAT_API_KEY=
# Back-office dashboard login (transactions / PSP logs) – fallback when no profile
UAT_DASHBOARD_USERNAME=
UAT_DASHBOARD_PASSWORD=

# Cashier test cards (<number>|<MM/YY>|<cvv>) – depend on the PSP the brand routes to.
# Only scenarios with a card run; CASHIER_CARDS=approved,declined limits the run.
UAT_CARD_APPROVED=
UAT_CARD_DECLINED=
CASHIER_CARDS=

# ----- LOCAL (defaults to test4 as well – see config/defaults.json) ---------
LOCAL_BASE_URL=
LOCAL_API_BASE_URL=
LOCAL_BRAND_ID=
LOCAL_API_KEY=
LOCAL_DASHBOARD_USERNAME=
LOCAL_DASHBOARD_PASSWORD=

# ----- Authentication behaviour ---------------------------------------------
# Purchase API expects:  Authorization: Bearer <API key>
API_KEY_HEADER=Authorization
API_KEY_PREFIX=Bearer
# OAuth2 client-credentials token path (leave empty – API-key auth is used)
AUTH_TOKEN_PATH=
CLIENT_ID=
CLIENT_SECRET=

# ----- Logging --------------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info
# Include (masked) request/response bodies in logs and report attachments
LOG_HTTP_BODIES=true

# ----- Reporting ------------------------------------------------------------
# Playwright trace mode: on | off | retain-on-failure | on-first-retry | on-all-retries
# Default: retain-on-failure locally, off in CI. Traces contain UNMASKED
# request data – never share them outside the team.
PW_TRACE=

# ----- Launcher UI ----------------------------------------------------------
LAUNCHER_PORT=4173
