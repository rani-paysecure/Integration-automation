# Server settings for docker compose – copy to .env.server ON THE SERVER (never commit it).

# Team login (required). Create the hash with:
#   docker compose run --rm --entrypoint node launcher tools/launcher/auth.js '<password>'
# (or locally: node tools/launcher/auth.js '<password>') and paste the printed line here.
# Keep the single quotes around the hash – without them docker compose treats each $ as a variable.
LAUNCHER_AUTH_USER=qa-team
LAUNCHER_AUTH_PASSWORD_HASH='scrypt$…'
# Hours until people have to sign in again (default 12).
# LAUNCHER_SESSION_HOURS=12

# Port on the server (default 4173). The AI gateway already uses 8081 on this host.
# LAUNCHER_PUBLIC_PORT=4173

# Environments offered on the server (default in the image: uat only – LOCAL is for your own machine).
# LAUNCHER_ENVIRONMENTS=uat

# Optional: only accept these Host headers, e.g. 23.29.114.29:4173
# LAUNCHER_ALLOWED_HOSTS=23.29.114.29:4173
